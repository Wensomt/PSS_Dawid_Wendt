{
  "info": {
    "name": "LAB03 – Bookmarks API (API Key + Limit/Offset)",
    "_postman_id": "lab3-bookmarks-col",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A — Security (API Key)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('ts', Date.now());"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "A1 GET /bookmarks bez klucza → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookmarks"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "A2 GET /bookmarks z kluczem → 200 (LimitOffsetPage)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookmarks"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has items[]',()=>pm.expect(Array.isArray(body.items)).to.be.true);",
                  "pm.test('Has limit/offset/total',()=>{ pm.expect(body).to.have.property('limit'); pm.expect(body).to.have.property('offset'); pm.expect(body).to.have.property('total'); });"
                ]
              }
            }
          ]
        }
      ]
    },
